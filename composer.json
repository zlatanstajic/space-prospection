{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "zlatanstajic/space-prospection",
  "type": "project",
  "description": "Space Prospection is a simple website built completely in the CodeIgniter framework.",
  "keywords": [
    "php",
    "codeigniter",
    "website",
    "mvc"
  ],
  "homepage": "https://github.com/zlatanstajic/space-prospection",
  "license": "MIT",
  "authors": [
    {
      "name": "Zlatan Stajic",
      "email": "contact@zlatanstajic.com",
      "homepage": "https://zlatanstajic.com",
      "role": "Author & Main Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-sqlite3": "*"
  },
  "require-dev": {
    "kenjis/ci-phpunit-test": "^3.0",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "scripts": {
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "php -S localhost:8080"
    ],
    "export:static": "@php .extras/export-static.php",
    "test": [
      "@test:phpcs",
      "@test:phpunit"
    ],
    "test:phpcs": "application/vendor/bin/phpcs --standard=.extras/phpcs.xml --colors application/controllers/ application/models/ application/tests/controllers/ application/tests/models/",
    "test:phpunit": "application/vendor/bin/phpunit -c application/tests/",
    "fix": "application/vendor/bin/phpcbf --standard=.extras/phpcs.xml application/controllers/ application/models/ application/tests/controllers/ application/tests/models/"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "vendor-dir": "application/vendor",
    "platform": {
      "php": "8.1"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
